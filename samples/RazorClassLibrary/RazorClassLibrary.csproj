<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Reference the props that would be brought in when consuming the RazorSlices package -->
  <Import Project="..\..\src\RazorSlices\build\RazorSlices.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <AssemblyName>RazorSlices.Samples.RazorClassLibrary</AssemblyName>
    <RootNamespace>RazorSlices.Samples.RazorClassLibrary</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <RazorSliceProxiesSealed>false</RazorSliceProxiesSealed>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0' and '$(RazorSlicesTestRuntimeAsync)' == 'true'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SourceGenerator\SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;SelfContained;RuntimeIdentifier" />
    <ProjectReference Include="..\..\src\RazorSlices\RazorSlices.csproj" />
  </ItemGroup>

  <!-- Reference the targets that would be brought in when consuming the RazorSlices package -->
  <Import Project="..\..\src\RazorSlices\build\RazorSlices.targets" />

</Project>

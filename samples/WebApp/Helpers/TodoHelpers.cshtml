@using RazorSlices
@using RazorSlices.Samples.WebApp.Helpers
@using RazorSlices.Samples.RazorClassLibrary.Helpers
@inherits RazorSliceHelpers
@implements ITodoHelpers
@functions {
    public void ActionButton(string operation, int id, string text, bool disabled = false)
    {
        <button type="button" class="btn btn-outline-primary" data-action="@operation" data-id="@id" disabled="@disabled">@text</button>
    }

    public void Statistic<T>(string label, T value) where T : ISpanFormattable
    {
        <div class="card card-body"><strong>@label</strong><span>@value</span></div>
    }

    public void TaskStatus(bool isComplete)
    {
        <span class="todo-status">@Helpers.UiHelpers.StatusBadge(isComplete ? "Completed" : "Incomplete", success: isComplete)</span>
    }

    public async ValueTask TaskSummaryAsync(Func<CancellationToken, ValueTask<string>> loadSummary)
    {
        <section class="todo-summary">
            @await Helpers.UiHelpers.AsyncNoticeAsync("Async task summary", loadSummary)
        </section>
    }
}

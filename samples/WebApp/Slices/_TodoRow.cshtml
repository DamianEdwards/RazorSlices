@using RazorSlices.Samples.RazorClassLibrary.Helpers
@inherits RazorSlice<Models.Todo>

<tr class="@(Model.IsComplete ? "complete" : null)">
    <td>@Model.Id</td>
    <td><a href="@Model.Id">@Model.Title</a></td>
    <td>@Model.DueBy</td>
    <td>@Helpers.UiHelpers.StatusBadge(Model.IsComplete ? "Completed" : "Incomplete", success: Model.IsComplete)</td>
</tr>

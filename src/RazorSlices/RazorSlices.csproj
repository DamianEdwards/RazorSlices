<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageTags>ASP.NET Web MinimalApis IResult Razor templating templates</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>razorslices-icon.png</PackageIcon>
    <AnalysisMode>Recommended</AnalysisMode>
    <AnalysisModeReliability>All</AnalysisModeReliability>
    <AnalysisModePerformance>All</AnalysisModePerformance>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <IsAotCompatible>true</IsAotCompatible>
    <Configurations>Debug;Release;Benchmarks</Configurations>
    <AssemblyName Condition=" '$(Configuration)' == 'Benchmarks' ">RazorSlices.ForBenchmarks</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Benchmarks' ">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- This is the T4 template service and is added by VS anytime you modify a T4 template. Required for .tt files. -->
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\razorslices-icon.png" Pack="true" PackagePath="\" />
    <None Include=".\build\**\*.*" Pack="true" PackagePath="build" />
    <None Include="..\..\.editorconfig" Link=".editorconfig" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <InternalsVisibleTo Include="RazorSlices.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="RazorSlice.Formattables.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>RazorSlice.Formattables.tt</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="RazorSlice.Formattables.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>RazorSlice.Formattables.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the source generator just to ensure it's built but don't reference its output -->
    <ProjectReference Include="..\SourceGenerator\SourceGenerator.csproj" OutputItemType="SourceGeneratorAssemblyPath" ReferenceOutputAssembly="false" Private="true" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeSourceGeneratorInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- Include source generator assembly in this project's package output -->
  <Target Name="IncludeSourceGeneratorInPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(SourceGeneratorAssemblyPath)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <UsingTask TaskName="RewritePackageReadme" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <DestinationFile ParameterType="System.String" Required="true" />
      <Commit ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!Regex.IsMatch(Commit, @"\A[0-9a-fA-F]{40}\z"))
        {
            Log.LogError("A full Git commit SHA is required to pack the README logo.");
            return false;
        }

        var readme = File.ReadAllText(SourceFile);
        const string imagePath = "assets/razorslices-logo.svg";
        if (!readme.Contains(imagePath))
        {
            Log.LogError("The README logo path was not found in the source README.");
            return false;
        }

        var imageUrl = $"https://raw.githubusercontent.com/DamianEdwards/RazorSlices/{Commit}/{imagePath}";
        Directory.CreateDirectory(Path.GetDirectoryName(DestinationFile));
        File.WriteAllText(DestinationFile, readme.Replace(imagePath, imageUrl));
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PreparePackageReadme" BeforeTargets="_GetPackageFiles" DependsOnTargets="InitializeSourceControlInformation">
    <RewritePackageReadme SourceFile="$(MSBuildProjectDirectory)\..\..\README.md"
                          DestinationFile="$(IntermediateOutputPath)Package.README.md"
                          Commit="$(SourceRevisionId)" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)Package.README.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>
  </Target>

</Project>
